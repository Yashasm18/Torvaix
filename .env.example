# =============================================================================
# Torvaix Environment Configuration
# =============================================================================

# Server Ports
PORT=3000
AGENT_PORT=3001
# Interface the agent server listens on. It can run shell commands, so keep loopback
# unless you deliberately need access from other devices.
AGENT_HOST=127.0.0.1
# Browsers may only call the agent from these origins (the web app normally calls it server-side).
# AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra Host names accepted besides localhost, e.g. a Docker service name or LAN hostname.
# AGENT_ALLOWED_HOSTS=
AGENT_SERVER_URL=http://localhost:3001

# Core Intelligence & Vector Infrastructure
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
PYTHON_SERVICE_URL=http://localhost:8000
# Chat model. Leave unset to auto-select an installed Ollama model (e.g. llama3.2:3b).
# TORVAIX_MODEL=llama3.2

# Security & Authentication
JWT_SECRET=torvaix-local-dev-secret-change-in-production

# Optional Cloud Provider Fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
